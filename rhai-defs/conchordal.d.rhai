/// Scoped callback execution with automatic population release.
/// Accepts 0-3 positional arguments, or an array of arguments.
fn play(callback: Fn, arg1: ?, arg2: ?, arg3: ?);
/// Scoped callback execution with automatic population release.
/// Accepts 0-3 positional arguments, or an array of arguments.
fn play(callback: Fn, arg1: [?]);

