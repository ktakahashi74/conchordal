---
import { compile } from 'sass';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from './Navigation.astro';
import Footer from './Footer.astro';
import { demo } from '../lib/demo';
const theme = compile('sass/main.scss', { style: 'compressed' }).css;
const { build, base, pieces } = demo()!;
const source = `https://github.com/ktakahashi74/conchordal/blob/${build.tag ?? build.commit}/samples/demo/`;
const loadMb = Math.round(build.wasmBytes / 1e6);
const release = `${build.tag ?? `v${build.version}-dev`} alpha preview`;
const length = (sec: number) => sec < 60 ? `${Math.round(sec / 10) * 10} s` : `${Math.round(sec / 60)} min`;
const version = build.tag ? `Conchordal ${build.tag}` : `Development build after v${build.version}, commit ${build.commit}${build.dirty ? ' (local changes)' : ''}`;
// No request may leave this origin: scripts, styles, workers and data come from 'self'.
// Inline script and style stay allowed because the site layout inlines small bundles.
const csp = "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'none'; object-src 'none'; form-action 'none'; base-uri 'none'";
---
<BaseLayout locale="en" slug="demo" title="Demo" englishOnly
  description="Conchordal performing live in your browser.">
  <meta slot="styles" http-equiv="Content-Security-Policy" content={csp} />
  <style slot="styles" is:inline set:html={theme}></style>
  <Navigation locale="en" slug="demo" />
  <main id="main-content" class="main demo-page" tabindex="-1" data-assets={base}
    data-tag={build.tag ?? ''} data-version={build.version} data-commit={build.commit}>
    <article class="page"><div class="container">
      <header class="demo-header">
        <h1 class="page-title">Demo</h1>
        <p class="release">Conchordal {release}</p>
      </header>

      <ul class="program" aria-label="Pieces">{pieces.map((piece, n) =>
        <li><button class="piece" data-piece={piece.id} aria-pressed={n === 0 ? 'true' : 'false'} disabled><span class="piece-title">{piece.title}</span><span class="piece-length">{length(piece.duration_sec)}</span></button></li>
      )}</ul>

      <section class="instrument" aria-label="Play Conchordal">
        <div class="controls">
          <div class="transport">
            <button id="demo-start" disabled>Start</button>
            <button id="demo-stop" disabled>Stop</button>
          </div>
          <p class="status"><span id="demo-state" role="status" aria-live="polite">Loading Conchordal…</span><span id="demo-time"></span></p>
          <div class="options">
            <label><input id="demo-repeat" type="checkbox" /> Repeat</label>
            <label><input id="demo-room" type="checkbox" checked /> Room</label>
            <button id="demo-view" aria-pressed="true">Display</button>
            <button id="demo-fullscreen">Full screen</button>
          </div>
        </div>
        <p id="demo-error" role="alert" hidden></p>
        <div id="demo-hardware" class="hardware" role="region" aria-label="Dropout report" hidden>
          <p>There was a dropout in this performance. To help find the cause, may we also send these details about this computer?</p>
          <pre id="demo-hardware-values"></pre>
          <div class="hardware-actions">
            <button id="demo-hardware-yes">Send these too</button>
            <button id="demo-hardware-no">Counters only</button>
          </div>
        </div>
        <div class="canvas-wrap"><canvas id="demo-gui" aria-label="Live ecology, rhythm, roughness and harmonicity"></canvas></div>
        <div class="panel-foot">
          <p class="consent"><label><input id="demo-send" type="checkbox" checked /> Send performance counters</label> <span>No sound is sent. <a href="#demo-sent">Details</a></span></p>
          <p>Desktop Chrome, Firefox and Safari. First load about {loadMb} MB.</p>
        </div>
      </section>

      <div class="demo-body">
        <section class="score-column" aria-labelledby="score-heading">
          <h2 id="score-heading">Score</h2>
          <p class="caption">Every Start is a new performance of the same score.</p>
          {pieces.map((piece, n) => (
            <div class="piece-score" data-piece={piece.id} hidden={n > 0}>
              <pre class="score"><code>{piece.scoreText}</code></pre>
              {piece.configText && <details><summary>Settings for this score ({piece.config})</summary><pre class="config"><code>{piece.configText}</code></pre></details>}
              <p class="score-links">
                <a href={`${base}pieces/${piece.score}`} download={piece.score}>Download</a>
                <a href={`${source}${piece.score}`}>GitHub</a>
              </p>
            </div>
          ))}
        </section>
        <aside class="notes" aria-label="About the piece">
          {pieces.map((piece, n) => (
            <div class="piece-about" data-piece={piece.id} hidden={n > 0}>
              <h2>{piece.title}</h2>
              {piece.authored_harmony && <p class="warning"><strong>Written harmony.</strong> {piece.authored_harmony}</p>}
              <h3>Written by the composer</h3>
              <p>{piece.authored}</p>
              <h3>Made by the ecology</h3>
              <p>{piece.generated}</p>
            </div>
          ))}
        </aside>
      </div>

      <details id="demo-sent" class="sent"><summary>Performance counters</summary>
        <p>After each performance, this page sends one record of performance counters to this site, to improve performance on computers we cannot test ourselves.</p>
        <ul>
          <li>The piece and the Conchordal version; how the performance ended and how long it lasted.</li>
          <li>Dropouts and when they happened; how much sound was prepared ahead; the audio output latency.</li>
          <li>Computation time per step, as a whole, per stage and per 5-second window; display times; time spent in a background tab.</li>
          <li>The browser and operating system, as named in the request your browser already sends.</li>
        </ul>
        <p>Not sent: sound, anything made from sound, the score, error text, identifiers or details of your computer. Only when a dropout happens does the page ask whether to add the computer details it shows you.</p>
        <p>Turn off “Send performance counters” to stop; this page remembers that choice in this browser. Browsers that signal Global Privacy Control start with sending off. Records are kept for up to three months, without IP addresses.</p>
        <details><summary>The record for the current performance</summary><pre id="demo-metrics"></pre></details>
      </details>

      <footer class="demo-footer"><p>{version}</p><p><a href={`${base}licenses.txt`}>Third-party licenses</a></p></footer>
    </div></article>
  </main>
  <Footer locale="en" />
  <script src="../scripts/demo.js"></script>
</BaseLayout>
<style>
  /* Tokens follow sass/main.scss so the demo reads as one of the site's inner pages. */
  .demo-page { color-scheme:dark; --bg2:#111; --bg3:#1a1a1a; --line:#27272a; --line2:#3f3f46; --text:#e4e4e7; --text2:#d4d4d8; --muted:#a1a1aa; --accent:#3b82f6; --accent2:#1d4ed8; --selected:rgba(59,130,246,.16); }
  .demo-header { text-align:center; margin-bottom:1.75rem; }
  .demo-header .page-title { margin-bottom:.25rem; }
  .release { margin:0; color:var(--muted); font-size:1rem; }

  /* The instrument: one panel, controls in a single row above the display. */
  .instrument { background:var(--bg2); border:1px solid var(--line); border-radius:8px; padding:0 12px; scroll-margin-top:5rem; }
  .instrument:fullscreen { width:100%; height:100%; border:0; border-radius:0; display:flex; flex-direction:column; }
  .instrument:fullscreen .canvas-wrap { flex:1; height:auto; min-height:0; }
  .controls { display:flex; flex-wrap:wrap; align-items:center; gap:10px 16px; padding:12px 0; }
  .transport, .options { display:flex; align-items:center; gap:8px; }
  .options { margin-left:auto; }
  button { font:inherit; font-size:.9375rem; font-weight:500; color:var(--text); background:var(--bg3); border:1px solid var(--line2); border-radius:6px; min-height:40px; padding:6px 16px; cursor:pointer; transition:border-color .15s ease, background-color .15s ease; }
  button:hover:not(:disabled) { border-color:var(--accent); }
  button:focus-visible, input:focus-visible { outline:2px solid #60a5fa; outline-offset:2px; }
  button:disabled { opacity:.45; cursor:default; }
  #demo-start { background:var(--accent); border-color:var(--accent); color:#fff; font-weight:600; min-width:96px; }
  #demo-start:hover:not(:disabled) { background:var(--accent2); border-color:var(--accent2); }
  #demo-view[aria-pressed="false"] { color:var(--muted); }
  /* The programme: one row per piece, the selected one marked. It grows as pieces are added. */
  .program { list-style:none; max-width:34rem; margin:0 auto 1.75rem; padding:0; border-top:1px solid var(--line); }
  .program li { margin:0; border-bottom:1px solid var(--line); }
  .piece { display:flex; justify-content:space-between; align-items:baseline; gap:1rem; width:100%; min-height:48px; padding:10px 14px; border:0; border-radius:0; background:transparent; text-align:left; color:var(--muted); }
  .piece:hover:not(:disabled) { color:var(--text); background:var(--bg2); }
  .piece:disabled { opacity:1; }
  .piece-title { font-size:1.0625rem; font-weight:600; }
  .piece-length { font-size:.875rem; font-variant-numeric:tabular-nums; }
  .piece[aria-pressed="true"] { color:var(--text); background:var(--selected); box-shadow:inset 3px 0 0 var(--accent); }
  .piece[aria-pressed="true"] .piece-length { color:var(--text2); }
  .status { display:flex; gap:12px; align-items:baseline; margin:0; min-width:12rem; font-size:.875rem; color:var(--muted); }
  #demo-time { font-variant-numeric:tabular-nums; color:var(--text2); }
  label { display:flex; align-items:center; gap:6px; cursor:pointer; font-size:.9375rem; color:var(--text2); }
  .options label { padding:0 4px; }
  input { width:16px; height:16px; margin:0; accent-color:var(--accent); }
  #demo-error { margin:0 0 12px; color:#fca5a5; overflow-wrap:anywhere; }
  .hardware { border:1px solid var(--accent); border-radius:8px; padding:12px; margin-bottom:12px; background:var(--bg3); }
  .hardware p { margin:0 0 8px; }
  .hardware pre { font-size:.8125rem; padding:12px; margin:0 0 8px; background:var(--bg2); border-radius:6px; overflow:auto; }
  .hardware-actions { display:flex; gap:8px; flex-wrap:wrap; }
  .canvas-wrap { height:clamp(320px,calc(100svh - 300px),760px); background:#000; border-radius:4px; overflow:hidden; }
  .canvas-wrap[hidden] { display:none; }
  canvas { display:block; width:100%; height:100%; }
  .panel-foot { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:4px 24px; padding:10px 0; font-size:.8125rem; color:var(--muted); }
  .panel-foot p { margin:0; }
  .consent { display:flex; flex-wrap:wrap; align-items:center; gap:4px 10px; }
  .consent label { font-size:.8125rem; }

  /* Below the instrument: the score beside what it means. */
  .demo-body { display:grid; grid-template-columns:minmax(0,1fr) minmax(16rem,22rem); gap:2.5rem; margin-top:3rem; }
  .demo-body h2 { font-size:1.25rem; font-weight:600; color:var(--text); margin:0 0 1rem; }
  .score-column pre { margin:0; }
  .score-column h2 { margin-bottom:.25rem; }
  .caption { margin:0 0 1rem; font-size:.9375rem; color:var(--muted); }
  pre.score, pre.config { background:var(--bg2); border:1px solid var(--line); border-radius:6px; overflow:auto; tab-size:4; font-size:.8125rem; line-height:1.55; padding:1.25rem; }
  pre.score { max-height:70svh; }
  pre code { font-size:inherit; }
  .score-links { display:flex; gap:1.5rem; margin:.75rem 0 0; font-size:.9375rem; }
  .notes { font-size:.9375rem; line-height:1.65; color:var(--text2); }
  .notes h3 { font-size:.9375rem; font-weight:600; color:var(--text); margin:1.25rem 0 .25rem; }
  .notes p { margin:0; }
  .warning { border-left:3px solid var(--accent); padding-left:.75rem; }
  details { margin-top:.75rem; }
  summary { cursor:pointer; color:var(--text2); width:fit-content; }
  summary:hover { color:var(--text); }

  .sent { max-width:46rem; margin-top:3rem; font-size:.9375rem; color:var(--text2); }
  .sent > summary { font-weight:600; }
  .sent p, .sent ul { margin:.75rem 0 0; }
  .sent pre { font-size:.8125rem; margin-top:.5rem; }
  .demo-footer { display:flex; flex-wrap:wrap; justify-content:space-between; gap:.5rem 2rem; margin-top:3rem; padding-top:1rem; border-top:1px solid var(--line); font-size:.875rem; color:var(--muted); }
  .demo-footer p { margin:0; }

  @media(max-width:900px) {
    .demo-body { grid-template-columns:1fr; gap:2rem; }
    .options { margin-left:0; }
  }
  @media(max-width:640px) {
    .instrument { padding:0 8px; }
    .controls { gap:8px; }
    button { padding:6px 10px; }
    .canvas-wrap { height:300px; }
    pre.score { padding:1rem; }
  }
  @media(prefers-reduced-motion:reduce) { button { transition:none; } }
</style>
