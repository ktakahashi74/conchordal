---
import type { CollectionEntry } from 'astro:content';
import { ui, type Locale } from '../i18n/ui';
interface Props { data: CollectionEntry<'pages'>['data']; technote: boolean; locale: Locale }
const { data, technote, locale } = Astro.props;
const extra = data.extra;
const showDate = data.date && extra.show_date !== false;
---
{technote ? <details class="page-provenance"><summary>{ui[locale].provenance}</summary><div class="page-meta page-meta-list">{Object.entries(extra).map(([key, value]) => <div class="page-extra-item"><span class="page-extra-key">{key === 'generated_by' ? 'auto-generated by' : key.replaceAll('_', ' ')}:</span>{' '}<span class="page-extra-value">{String(value)}</span></div>)}</div></details> :
  (showDate || extra.author || extra.author_email) && <div class="page-meta">
    {showDate && <time class="page-date" datetime={data.date!.toISOString()}>{data.date!.toLocaleDateString('en-US', { month: 'long', day: '2-digit', year: 'numeric', timeZone: 'UTC' })}</time>}
    {extra.author && <span class="page-author">{String(extra.author)}</span>}
    {extra.author_email && <a class="page-author-email" href={`mailto:${extra.author_email}`}>{String(extra.author_email)}</a>}
  </div>
}
