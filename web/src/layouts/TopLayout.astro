---
import BaseLayout from './BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Masthead from '../components/Masthead.astro';
import Roadmap from '../components/Roadmap.astro';
import type { Locale } from '../i18n/ui';
import '../styles/custom.css';
interface Props { locale: Locale; lede?: string; notFound?: boolean }
const { locale, lede, notFound = false } = Astro.props;
// Theme markup retains Blackrock Digital's MIT attribution in web/licenses/.
---
<BaseLayout locale={locale} slug="" top notFound={notFound}>
  <Fragment slot="styles">
    <link href="https://fonts.googleapis.com/css?family=Varela+Round" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
  </Fragment>
  <Navigation locale={locale} slug="" top />
  <main id="main-content" tabindex="-1">
    {notFound ? <slot /> : <><Masthead locale={locale} lede={lede}><slot /></Masthead><Roadmap /></>}
  </main>
  <Footer locale={locale} top />
  <Fragment slot="scripts">
    <script>
      /*!
       * Adapted from Start Bootstrap - Grayscale v7.0.6.
       * Copyright 2013-2023 Start Bootstrap.
       * MIT: https://github.com/StartBootstrap/startbootstrap-grayscale/blob/master/LICENSE
       */
      import Collapse from 'bootstrap/js/dist/collapse';
      import ScrollSpy from 'bootstrap/js/dist/scrollspy';

      document.addEventListener('DOMContentLoaded', () => {
        const mainNav = document.querySelector('#mainNav');
        if (mainNav) {
          const shrinkNavbar = () => mainNav.classList.toggle('navbar-shrink', window.scrollY !== 0);
          shrinkNavbar();
          document.addEventListener('scroll', shrinkNavbar, { passive: true });
          new ScrollSpy(document.body, { target: '#mainNav', rootMargin: '0px 0px -40%' });
        }

        const toggler = document.querySelector('.navbar-toggler');
        const menu = document.querySelector('#navbarResponsive');
        if (toggler && menu) {
          document.querySelectorAll('#navbarResponsive .nav-link').forEach(link => {
            link.addEventListener('click', () => {
              if (window.getComputedStyle(toggler).display !== 'none') {
                Collapse.getOrCreateInstance(menu, { toggle: false }).hide();
              }
            });
          });
        }
      });
    </script>
  </Fragment>
</BaseLayout>
