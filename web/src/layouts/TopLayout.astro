---
import BaseLayout from './BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Masthead from '../components/Masthead.astro';
import Roadmap from '../components/Roadmap.astro';
import type { Locale } from '../i18n/ui';
import '../styles/custom.css';
interface Props { locale: Locale; lede?: string; notFound?: boolean }
const { locale, lede, notFound = false } = Astro.props;
// Theme markup retains Blackrock Digital's MIT attribution in web/licenses/.
---
<BaseLayout locale={locale} slug="" top notFound={notFound}>
  <Fragment slot="styles">
    <link href="https://fonts.googleapis.com/css?family=Varela+Round" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
  </Fragment>
  <Navigation locale={locale} slug="" top />
  <main id="main-content" tabindex="-1">
    {notFound ? <slot /> : <><Masthead locale={locale} lede={lede}><slot /></Masthead><Roadmap /></>}
  </main>
  <Footer locale={locale} top />
  <Fragment slot="scripts">
    <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script is:inline src="/js/scripts.js"></script>
  </Fragment>
</BaseLayout>
