---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { pageInfo } from '../lib/pages';
import InnerLayout from '../layouts/InnerLayout.astro';

export async function getStaticPaths() {
  return (await getCollection('pages')).filter(entry => pageInfo(entry).slug).map(entry => ({
    params: { path: pageInfo(entry).path.replace(/^\/|\/$/g, '') }, props: { entry },
  }));
}
interface Props { entry: CollectionEntry<'pages'> }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<InnerLayout entry={entry} headings={headings}><Content /></InnerLayout>
